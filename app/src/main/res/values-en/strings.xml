    <!-- Xiaomi HyperOS & System Compatibility Screen -->
    <string name="hyperos_screen_title">Xiaomi HyperOS &amp; Background Compatibility</string>
    <string name="hyperos_screen_subtitle">Tailored guidance for Xiaomi Redmi Note 13 Pro 5G and Android 14+ background persistence</string>
    <string name="hyperos_detected_banner">Detected Device Environment</string>
    <string name="hyperos_honest_note">Technical Note: Android 14 and Xiaomi HyperOS enforce strict background process management. Nexa Island uses standard event-driven services, but manual HyperOS configuration is required to prevent OS termination:</string>
    <string name="hyperos_step_autostart_title">1. Enable Background Autostart</string>
    <string name="hyperos_step_autostart_desc">Open App Info in HyperOS ⬅ Enable Background Autostart so the service recovers automatically after device reboot.</string>
    <string name="hyperos_step_battery_title">2. Set Battery Saver to "No Restrictions"</string>
    <string name="hyperos_step_battery_desc">In App Info ⬅ Battery ⬅ Select "No restrictions" instead of the default HyperOS Battery Saver.</string>
    <string name="hyperos_step_lockscreen_title">3. Lock Screen &amp; Background Pop-up Permissions</string>
    <string name="hyperos_step_lockscreen_desc">In App Info ⬅ Other permissions ⬅ Enable "Show on Lock screen" and "Display pop-up windows while running in the background".</string>
    <string name="hyperos_step_recents_title">4. Lock App in Recents Overview</string>
    <string name="hyperos_step_recents_desc">Open Recents ⬅ Long-press the Nexa Island card ⬅ Tap the Lock icon so clearing RAM does not stop the overlay.</string>
